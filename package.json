    "dustjs-linkedin": "3.0.1",
    "ejs": "3.1.10",
    "ejs-locals": "1.0.2",
    "errorhandler": "1.4.3",
    "express": "4.22.3",
    "express-fileupload": "1.4.0",
    "express-session": "^1.17.2",
    "file-type": "^8.1.0",
    "hbs": "^4.0.4",
    "humanize-ms": "1.2.1",
    "jquery": "^3.5.0",
    "lodash": "4.18.1",
    "marked": "4.0.10",
    "method-override": "latest",
    "moment": "2.31.0",
    "mongodb": "^3.5.9",
    "mongoose": "6.13.10",
    "morgan": "latest",
    "ms": "^0.7.1",
    "mysql2": "^3.15.3",
    "npmconf": "2.1.3",
    "optional": "^0.1.3",
    "st": "1.2.2",
